{
  "name": "@rrd-analyzer/ui-landing",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && pnpm --filter @rrd-analyzer/ui-analyzer build:browser && pnpm embed:app",
    "embed:app": "rm -rf dist/browser/app && cp -R ../ui-analyzer/dist/browser-edition dist/browser/app",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/report",
    "docker:build": "docker build --file Dockerfile --tag rrd-analyzer-landing ../..",
    "docker:run": "docker run --rm --publish 8080:8080 rrd-analyzer-landing"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "22.1.6",
    "@rrd-analyzer/shared": "workspace:*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
