{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui-landing": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "theme-boot.js",
                "input": "node_modules/@rrd-analyzer/ui-shared/assets"
              }
            ],
            "styles": ["src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            },
            "outputPath": "dist"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "600kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "define": {
                "RELEASE_VERSION": "'0.0.0'"
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4300
          },
          "configurations": {
            "production": {
              "buildTarget": "ui-landing:build:production"
            },
            "development": {
              "buildTarget": "ui-landing:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageInclude": ["src/**/*.ts"],
            "coverageExclude": [
              "src/**/*.spec.ts",
              "src/**/*.fixture.ts",
              "src/main.ts",
              "src/main.server.ts",
              "src/app/app.config.ts",
              "src/app/app.config.server.ts",
              "src/app/app.routes.server.ts"
            ],
            "coverageReporters": [
              [
                "text",
                {
                  "skipFull": true
                }
              ],
              "text-summary"
            ],
            "coverageThresholds": {
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            }
          }
        }
      }
    }
  }
}
