{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rrd-analyzer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../ui-landing/dist/browser",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE_SESSIONS", "class_name": "LiveSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveSession"] }],
  "r2_buckets": [{ "binding": "SESSION_BLOBS", "bucket_name": "rrd-analyzer-sessions" }],
  "ratelimits": [
    {
      "name": "SESSION_CREATION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "MAXIMUM_CHUNK_BYTES": 8388636,
    "MAXIMUM_STATE_BYTES": 4194304,
    "MAXIMUM_SESSION_BYTES": 268435456,
    "MAXIMUM_SESSION_FILES": 256,
    "INACTIVITY_MILLISECONDS": 3600000,
    "ALLOWED_ORIGINS": ""
  },
  "observability": { "enabled": true }
}
