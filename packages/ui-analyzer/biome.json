{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.json",
      "e2e/**/*.ts",
      "playwright.config.ts",
      "tools/**/*.mjs",
      "*.json",
      "!**/dist",
      "!**/.angular",
      "!**/node_modules",
      "!e2e/report",
      "!e2e/.artifacts",
      "!tools/design-check/shots"
    ]
  },
  "overrides": [
    {
      "includes": ["tools/**/*.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
