{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui-analyzer": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "theme-boot.js",
                "input": "node_modules/@rrd-analyzer/ui-shared/assets"
              }
            ],
            "styles": ["src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            },
            "outputPath": {
              "base": "../daemon/cmd/rrd-analyzer/dist",
              "browser": ""
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "browser": {
              "outputPath": {
                "base": "dist/browser-edition",
                "browser": ""
              },
              "baseHref": "/app/",
              "fileReplacements": [
                {
                  "replace": "src/app/core/config/edition.config.ts",
                  "with": "src/app/core/config/edition.browser.config.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "**/*",
                  "input": "browser-runtime",
                  "output": "browser-runtime"
                },
                {
                  "glob": "theme-boot.js",
                  "input": "node_modules/@rrd-analyzer/ui-shared/assets"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ui-analyzer:build:production"
            },
            "development": {
              "buildTarget": "ui-analyzer:build:development"
            },
            "browser": {
              "buildTarget": "ui-analyzer:build:development,browser",
              "port": 4210
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageInclude": ["src/**/*.ts"],
            "coverageExclude": ["src/**/*.spec.ts", "src/**/*.fixture.ts", "src/main.ts", "src/app/app.config.ts"],
            "coverageReporters": [
              [
                "text",
                {
                  "skipFull": true
                }
              ],
              "text-summary"
            ],
            "coverageThresholds": {
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            }
          }
        }
      }
    }
  }
}
